# ============================================================
# HuggingMes environment variables (Space Variables & Secrets)
# Copy the keys you need into your HF Space secrets/variables.
# Never commit real secret VALUES to a repository.
# ============================================================

# ── Core ──
# LLM_API_KEY: your provider API key (OpenRouter, Anthropic, OpenAI,
#   Google, DeepSeek, xAI, Z.ai/GLM, OpenCode Zen, etc.)
LLM_API_KEY=

# LLM_MODEL: model or provider model ID. Examples:
#   openrouter/anthropic/claude-sonnet-4
#   openai/gpt-4o
#   opencode-zen/deepseek-v4-flash-free   (Zen gateway)
LLM_MODEL=

# GATEWAY_TOKEN: strong token securing the dashboard and API.
# Generate with: openssl rand -hex 32
GATEWAY_TOKEN=

# ── Backup & Persistence ──
# HF_TOKEN: Hugging Face token with WRITE access. Enables automatic
# workspace backup to a private dataset every SYNC_INTERVAL seconds.
HF_TOKEN=
# Backup dataset name (default: huggingmes-backup)
BACKUP_DATASET_NAME=
# Sync frequency in seconds (default: 600)
SYNC_INTERVAL=

# ── Custom OpenAI-compatible endpoint ──
# Point the agent at your own /v1 gateway instead of a built-in provider.
# Example: CUSTOM_BASE_URL=https://opencode.ai/zen/v1
#          LLM_MODEL=deepseek-v4-flash-free
#          CUSTOM_API_KEY=your-key-or-placeholder
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
# Context window of the configured model in tokens (default: 131072)
CUSTOM_MODEL_CONTEXT_LENGTH=
# Max output tokens (default: 8192)
CUSTOM_MODEL_MAX_TOKENS=

# ── Discord ──
# DISCORD_BOT_TOKEN: bot token from the Discord Developer Portal.
# Set this secret and Hermes auto-connects on boot — no shell needed.
DISCORD_BOT_TOKEN=
# Optional comma-separated numeric user IDs allowed to chat with the bot.
DISCORD_ALLOWED_USERS=

# ── Startup scripts ──
# HUGGINGMES_RUN: full bash script executed on every startup
# (multi-line, heredocs, if blocks all work).
HUGGINGMES_RUN=
# Space-separated packages to install at boot.
HUGGINGMES_APT_PACKAGES=
HUGGINGMES_PIP_PACKAGES=
HUGGINGMES_NPM_PACKAGES=

# ── Advanced ──
# API server enabled (default: true)
API_SERVER_ENABLED=
# Gateway restart policy (default 5s delay, unlimited restarts)
GATEWAY_RESTART_DELAY=
GATEWAY_MAX_RESTARTS=
# WEBHOOK_URL: endpoint that receives a POST JSON notification
# each time the Space finishes starting (wake/start notification).
WEBHOOK_URL=